# Copy file này thành `.env` rồi điền giá trị thật.
# `.env` đã nằm trong .gitignore — không bao giờ commit credential.

# ---------- Database ----------
# MongoDB Atlas (primary) — bắt buộc
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Neon PostgreSQL (fallback) — tùy chọn
NEON_DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# ---------- Auth ----------
# Chuỗi ngẫu nhiên đủ dài, dùng để ký JWT
JWT_SECRET=

# ---------- URLs ----------
# Local: http://localhost:3000 — Production: https://your-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------- SMTP ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Bật true để chuyển hướng mọi email về SMTP_ADMIN_EMAIL (dùng khi dev)
SMTP_TRIAL_MODE=false
SMTP_ADMIN_EMAIL=

# Chưa được code sử dụng, giữ để dự phòng
MAILERSEND_API_KEY=

# ---------- Inference stack (tương thích OpenAI API) ----------
# Bắt buộc nếu muốn dùng tính năng sinh sơ đồ bằng AI.
# KHÔNG đặt prefix NEXT_PUBLIC_ — key chỉ được đọc ở server.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=120000

# ---------- Chưa được code sử dụng ----------
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=./uploads
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000
LOG_LEVEL=info

# Không set NODE_ENV — Next.js tự quản lý.
